# Capital Forge environment variables
# Copy this file to .env.local for local development.
# Never commit real API keys to GitHub. Add real values only in Vercel Project Settings -> Environment Variables.

# Supabase cloud auth + persistence
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Primary AI provider: OpenAI-compatible chat/completions endpoint
# NVIDIA NIM example: AI_API_URL=https://integrate.api.nvidia.com/v1
AI_API_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4.1-mini

# Live financial news provider: Marketaux
NEWS_API_PROVIDER=marketaux
NEWS_API_URL=https://api.marketaux.com/v1/news/all
NEWS_API_KEY=

# Primary market price provider: Twelve Data
MARKET_DATA_PROVIDER=twelvedata
MARKET_DATA_API_URL=https://api.twelvedata.com
MARKET_DATA_API_KEY=

# Backup market quote provider: Alpha Vantage
BACKUP_MARKET_PROVIDER=alphavantage
BACKUP_MARKET_API_KEY=
# Alternative supported name
ALPHA_VANTAGE_API_KEY=

# Fundamentals provider: Financial Modeling Prep
FUNDAMENTALS_PROVIDER=fmp
FUNDAMENTALS_API_URL=https://financialmodelingprep.com/api/v3
FUNDAMENTALS_API_KEY=
# Alternative supported name
FMP_API_KEY=

# Optional filings provider
FILINGS_API_URL=
FILINGS_API_KEY=

# Optional recruiter/project scoring provider
RESUME_REVIEW_API_URL=
RESUME_REVIEW_API_KEY=

# Optional admin mode secret for future protected imports
CAPITAL_FORGE_ADMIN_SECRET=
